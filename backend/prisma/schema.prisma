generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                     Int                      @id @default(autoincrement())
  nombre                 String                   @db.VarChar(100)
  email                  String                   @unique @db.VarChar(150)
  password_hash          String
  rif_cedula             String?                  @unique @db.VarChar(20)
  telefono               String?                  @db.VarChar(20)
  role                   user_role                @default(CLIENT)
  created_at             DateTime                 @default(now())
  appointments_as_client appointments[]           @relation("ClientAppointments")
  appointments_as_tech   appointments[]           @relation("TechAppointments")
  inventory_transactions inventory_transactions[]
  messages               messages[]
  part_requests          part_requests[]
}

model equipments {
  id            Int            @id @default(autoincrement())
  tipo_equipo   String         @db.VarChar(100)
  marca         String         @db.VarChar(50)
  modelo        String         @db.VarChar(50)
  serial_number String         @unique @db.VarChar(100)
  imagenes_url  String[]
  created_at    DateTime       @default(now())
  appointments  appointments[]

  @@index([serial_number], map: "idx_equipment_serial")
}

model appointments {
  id                     Int                      @id @default(autoincrement())
  client_id              Int?
  tech_id                Int?
  equipment_id           Int?
  descripcion_falla      String
  status                 appointment_status       @default(RECEIVED)
  fecha_cita             DateTime
  notas_tecnicas         String?
  created_at             DateTime                 @default(now())
  client                 users?                   @relation("ClientAppointments", fields: [client_id], references: [id])
  equipment              equipments?              @relation(fields: [equipment_id], references: [id])
  tech                   users?                   @relation("TechAppointments", fields: [tech_id], references: [id])
  inventory_transactions inventory_transactions[]
  messages               messages[]
  part_requests          part_requests[]

  @@index([status], map: "idx_appointment_status")
}

model inventory {
  id                     Int                      @id @default(autoincrement())
  sku                    String                   @unique @db.VarChar(50)
  nombre_repuesto        String                   @db.VarChar(150)
  cantidad               Int                      @default(0)
  cantidad_minima        Int                      @default(5)
  costo_unitario         Decimal?                 @db.Decimal(10, 2)
  proveedor              String?                  @db.VarChar(100)
  last_restock           DateTime?
  inventory_transactions inventory_transactions[]
  part_requests          part_requests[]
}

model messages {
  id             Int           @id @default(autoincrement())
  appointment_id Int?
  sender_id      Int?
  mensaje        String
  leido          Boolean       @default(false)
  created_at     DateTime      @default(now())
  appointment    appointments? @relation(fields: [appointment_id], references: [id])
  sender         users?        @relation(fields: [sender_id], references: [id])

  @@index([appointment_id, created_at], map: "idx_chat_messages")
}

model part_requests {
  id             Int            @id @default(autoincrement())
  inventory_id   Int
  tech_id        Int
  appointment_id Int?
  quantity       Int
  status         request_status @default(PENDING)
  requested_at   DateTime       @default(now())
  resolved_at    DateTime?
  notes          String?
  appointment    appointments?  @relation(fields: [appointment_id], references: [id])
  inventory      inventory      @relation(fields: [inventory_id], references: [id])
  tech           users          @relation(fields: [tech_id], references: [id])
}

model inventory_transactions {
  id             Int              @id @default(autoincrement())
  inventory_id   Int
  appointment_id Int?
  user_id        Int
  type           transaction_type
  quantity       Int
  price_at_time  Decimal?         @db.Decimal(10, 2)
  created_at     DateTime         @default(now())
  appointment    appointments?    @relation(fields: [appointment_id], references: [id])
  inventory      inventory        @relation(fields: [inventory_id], references: [id])
  user           users            @relation(fields: [user_id], references: [id])
}

enum user_role {
  ADMIN
  TECH
  CLIENT
}

enum appointment_status {
  RECEIVED
  DIAGNOSING
  WAITING_PARTS
  FINISHED
  DELIVERED
}

enum request_status {
  PENDING
  APPROVED
  REJECTED
}

enum transaction_type {
  REPAIR_USE
  SALE
  RESTOCK
  ADJUSTMENT
}
