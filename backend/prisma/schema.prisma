generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  ADMIN
  TECH
  CLIENT
}

enum appointment_status {
  RECEIVED
  DIAGNOSING
  WAITING_PARTS
  FINISHED
  DELIVERED
}

model users {
  id            Int       @id @default(autoincrement())
  nombre        String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  password_hash String
  rif_cedula    String?   @unique @db.VarChar(20)
  telefono      String?   @db.VarChar(20)
  role          user_role @default(CLIENT)
  created_at    DateTime  @default(now())

  // Relaciones inversas
  appointments_as_client appointments[] @relation("ClientAppointments")
  appointments_as_tech   appointments[] @relation("TechAppointments")
  messages               messages[]
}

model equipments {
  id            Int      @id @default(autoincrement())
  tipo_equipo   String   @db.VarChar(100)
  marca         String   @db.VarChar(50)
  modelo        String   @db.VarChar(50)
  serial_number String   @unique @db.VarChar(100)
  imagenes_url  String[] // Array text
  created_at    DateTime @default(now())

  // Relaciones
  appointments appointments[]

  @@index([serial_number], name: "idx_equipment_serial")
}

model appointments {
  id                Int                @id @default(autoincrement())
  client_id         Int?
  tech_id           Int?
  equipment_id      Int?
  descripcion_falla String             @db.Text
  status            appointment_status @default(RECEIVED)
  fecha_cita        DateTime
  notas_tecnicas    String?            @db.Text
  created_at        DateTime           @default(now())

  // Relaciones
  client    users?      @relation("ClientAppointments", fields: [client_id], references: [id])
  tech      users?      @relation("TechAppointments", fields: [tech_id], references: [id])
  equipment equipments? @relation(fields: [equipment_id], references: [id])
  messages  messages[]

  @@index([status], name: "idx_appointment_status")
}

model inventory {
  id              Int       @id @default(autoincrement())
  sku             String    @unique @db.VarChar(50)
  nombre_repuesto String    @db.VarChar(150)
  cantidad        Int       @default(0)
  cantidad_minima Int       @default(5)
  costo_unitario  Decimal?  @db.Decimal(10, 2)
  proveedor       String?   @db.VarChar(100)
  last_restock    DateTime?
}

model messages {
  id             Int      @id @default(autoincrement())
  appointment_id Int?
  sender_id      Int?
  mensaje        String   @db.Text
  leido          Boolean  @default(false)
  created_at     DateTime @default(now())

  // Relaciones
  appointment appointments? @relation(fields: [appointment_id], references: [id])
  sender      users?        @relation(fields: [sender_id], references: [id])

  @@index([appointment_id, created_at], name: "idx_chat_messages")
}
